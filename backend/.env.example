# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service role key (NOT the anon key) — stays server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret for verifying Supabase session tokens
# Found at: Supabase dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── App ───────────────────────────────────────────────────────────────────────
# Port the FastAPI server listens on (default 8000)
PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
